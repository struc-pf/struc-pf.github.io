---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { site } from '../data/site';

const links = [...site.nav, { label: 'Privacy', href: '/privacy/' }];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container inner">
    <div class="about">
      <p class="brand">
        <Image src={logo} alt="" width={32} height={32} densities={[1, 2]} />
        <span>{site.name}</span>
      </p>
      <p class="description">{site.description}</p>
    </div>

    <nav aria-label="Footer">
      <ul>
        {links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <ul class="contact">
      <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
      <li><a href={site.linkedIn} rel="noopener">LinkedIn</a></li>
    </ul>

    <p class="legal">
      © {year} {site.legalName}. Company number {site.companyNumber}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
  }

  .inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 32px;
    padding-block: 48px 40px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--color-ink);
    font-size: 1.25rem;
    font-weight: 600;
  }

  .brand img {
    width: 32px;
    height: 32px;
  }

  .description {
    max-width: 34ch;
    margin-top: 12px;
  }

  ul {
    padding: 0;
    list-style: none;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
  }

  .legal {
    grid-column: 1 / -1;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
    font-size: 0.875rem;
  }

  @media (max-width: 719px) {
    .inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .about {
      grid-column: 1 / -1;
    }
  }
</style>
