---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'>;
  /** Heading level for the title, so cards fit the page outline. */
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, tag, services } = entry.data;
---

<article class="card case-card">
  <p class="tag">{tag} · {services.join(', ')}</p>
  <Heading class="title">{title}</Heading>
  <a class="more" href={`/work/${entry.id}/`}>
    Read the story<span class="visually-hidden">: {title}</span>
  </a>
</article>

<style>
  .case-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 28px;
  }

  .tag {
    color: var(--color-accent-text);
    font-size: 0.875rem;
    font-weight: 500;
  }

  .title {
    font-size: 1.1875rem;
    line-height: 1.35;
  }

  .more {
    align-self: flex-start;
    margin-top: auto;
    padding-block: 12px;
  }

  .more::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .more:focus-visible {
    outline: none;
  }

  .more:focus-visible::after {
    outline: 3px solid var(--color-ink);
    outline-offset: 2px;
  }
</style>
