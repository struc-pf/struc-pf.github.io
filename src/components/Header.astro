---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import Button from './Button.astro';
import { site } from '../data/site';

const path = Astro.url.pathname;
const isCurrent = (href: string) => path.startsWith(href);
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Image src={logo} alt="" width={40} height={40} densities={[1, 2]} loading="eager" />
      <span>{site.name}</span>
    </a>

    <nav class="links" aria-label="Main">
      <ul>
        {
          site.nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="cta">
      <Button href={site.bookingUrl}>Book a call</Button>
    </div>

    <details class="menu">
      <summary>Menu</summary>
      <nav aria-label="Main">
        <ul>
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </details>
  </div>
</header>

<style>
  .bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px 32px;
    padding-block: 24px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
    color: var(--color-ink);
    font-size: 1.375rem;
    font-weight: 600;
    text-decoration: none;
  }

  .brand img {
    width: 40px;
    height: 40px;
  }

  ul {
    display: flex;
    gap: 32px;
    padding: 0;
    list-style: none;
  }

  .links a,
  .menu a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-body);
    font-weight: 400;
    text-decoration: none;
  }

  .links a:hover,
  .menu a:hover,
  .links a[aria-current],
  .menu a[aria-current] {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 2px;
  }

  .menu {
    display: none;
  }

  .menu summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 2px solid var(--color-primary);
    border-radius: var(--radius);
    color: var(--color-primary);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .menu summary::-webkit-details-marker {
    display: none;
  }

  .menu nav {
    position: absolute;
    top: calc(100% - 8px);
    right: 0;
    left: 0;
    z-index: 5;
    padding: 8px 20px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .menu ul {
    flex-direction: column;
    gap: 0;
  }

  .menu a {
    width: 100%;
  }

  @media (max-width: 719px) {
    .links {
      display: none;
    }

    .menu {
      display: block;
    }

    .bar {
      gap: 8px;
      padding-block: 14px;
    }

    .brand img {
      width: 34px;
      height: 34px;
    }

    .cta :global(.button) {
      padding-inline: 14px;
    }
  }
</style>
