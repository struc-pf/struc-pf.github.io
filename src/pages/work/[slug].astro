---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Diagram from '../../components/Diagram.astro';
import NumberedSteps from '../../components/NumberedSteps.astro';
import Prose from '../../components/Prose.astro';
import Testimonial from '../../components/Testimonial.astro';
import { services as allServices } from '../../data/services';
import { getPublishedWork } from '../../data/work';

export async function getStaticPaths() {
  const work = await getPublishedWork();
  return work.map((entry, index) => ({
    params: { slug: entry.id },
    props: { entry, next: work.length > 1 ? work[(index + 1) % work.length] : undefined },
  }));
}

const { entry, next } = Astro.props;
const {
  title,
  clientType,
  services,
  summary,
  stats = [],
  challengeTitle,
  challenges,
  diagram,
  stepsTitle,
  steps,
  outcomesTitle,
  outcomes,
  quotes = [],
} = entry.data;
const { Content } = await render(entry);
const hasBody = (entry.body ?? '').trim().length > 0;
const related = allServices.filter((service) => services.includes(service.name));
---

<Base title={`${title} | Struc`} description={summary}>
  <article class="container case">
    <header>
      <p class="eyebrow">{clientType} · {services.join(', ')}</p>
      <h1>{title}</h1>
      <p class="lead">{summary}</p>
    </header>

    {
      stats.length > 0 && (
        <dl class="stats">
          {stats.map((stat) => (
            <div class="card">
              <dt>{stat.caption}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <section class="panel">
      <h2>{challengeTitle}</h2>
      <ul class="points two">
        {
          challenges.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      diagram && (
        <section>
          <h2>{diagram.title}</h2>
          <Diagram layout={diagram.layout} items={diagram.items} caption={diagram.caption} />
        </section>
      )
    }

    {
      steps && steps.length > 0 && (
        <section>
          <h2>{stepsTitle}</h2>
          <NumberedSteps steps={steps} />
        </section>
      )
    }

    <section class="band">
      <h2>{outcomesTitle}</h2>
      <ul class="points">
        {
          outcomes.map((item) => (
            <li>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    {
      quotes.length > 0 && (
        <div class="quotes">
          {quotes.map((quote) => (
            <Testimonial quote={quote} />
          ))}
        </div>
      )
    }

    {
      hasBody && (
        <Prose>
          <Content />
        </Prose>
      )
    }

    <nav class="onward" aria-label="More">
      <p>
        <span class="label">{related.length === 1 ? 'Related service' : 'Related services'}</span>
        {related.map((service) => <a href={`/services/#${service.id}`}>{service.name}</a>)}
      </p>
      {
        next && (
          <p>
            <span class="label">Next case study</span>
            <a href={`/work/${next.id}/`}>{next.data.title}</a>
          </p>
        )
      }
    </nav>
  </article>
</Base>

<style>
  .case {
    display: flex;
    flex-direction: column;
    gap: 48px;
    padding-top: 56px;
  }

  h1 {
    max-width: 22ch;
    margin-top: 12px;
  }

  .lead {
    max-width: 62ch;
    margin-top: 20px;
  }

  h2 {
    margin-bottom: 24px;
    font-size: 1.5rem;
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 6px;
    padding: 24px 28px;
  }

  dd {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: 2.75rem;
    font-weight: 600;
    line-height: 1.1;
  }

  dt {
    font-size: 0.9375rem;
  }

  .panel,
  .band {
    padding: 36px 40px;
    border-radius: var(--radius);
  }

  .panel {
    background: var(--color-panel);
  }

  .band {
    background: var(--color-primary);
    color: #fff;
  }

  .band h2,
  .band h3 {
    color: #fff;
  }

  .points {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 24px 32px;
    padding: 0;
    list-style: none;
  }

  .points.two {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .points h3 {
    font-size: 1.125rem;
  }

  .panel h3 {
    color: var(--color-accent-text);
  }

  .points p {
    margin-top: 4px;
    font-size: 0.9375rem;
  }

  .quotes {
    display: grid;
    gap: 20px;
  }

  .onward {
    display: flex;
    flex-wrap: wrap;
    gap: 24px 64px;
    padding-top: 28px;
    border-top: 1px solid var(--color-border);
  }

  .onward p {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 20px;
  }

  .label {
    flex-basis: 100%;
    color: var(--color-accent-text);
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .onward a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  @media (max-width: 859px) {
    .stats {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 639px) {
    .case {
      gap: 40px;
      padding-top: 32px;
    }

    .panel,
    .band {
      padding: 24px;
    }

    .points.two {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
